{
  "name": "chinese-reading",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "authoring:frequency": "node authoring/scripts/frequency.mjs",
    "authoring:frequency:import": "python3 authoring/scripts/import_frequency.py",
    "authoring:bank": "node authoring/scripts/content.mjs bank",
    "authoring:check": "node authoring/scripts/content.mjs check",
    "authoring:check:drafts": "node authoring/scripts/content.mjs check --draft authoring/drafts/initial-stories.ts",
    "authoring:typecheck": "tsc --noEmit -p authoring/tsconfig.json",
    "authoring:test": "node --test authoring/tests/*.test.mjs",
    "predev": "npm run db:migrate",
    "dev": "react-router dev --host 127.0.0.1",
    "prebuild": "npm run authoring:check",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:revision": "playwright test --config playwright.revision.config.ts",
    "test:revision:check": "node tests/revision-check.mjs",
    "test:revision:build": "npm run authoring:check && npm run test:revision:check && react-router build --mode revision-fixture",
    "test:revision:serve": "npm run test:revision:build && wrangler d1 migrations apply DB --config wrangler.jsonc --local --persist-to .wrangler/playwright-revision && wrangler dev --config .wrangler/revision-build/server/wrangler.json --local --ip 127.0.0.1 --port 4174 --inspector-port 0 --persist-to .wrangler/playwright-revision",
    "test:serve": "npm run build && wrangler d1 migrations apply DB --local --persist-to .wrangler/playwright && wrangler dev --config build/server/wrangler.json --local --ip 127.0.0.1 --port 4173 --inspector-port 0 --persist-to .wrangler/playwright",
    "cf-typegen": "wrangler types",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "wrangler": "^4.156.1"
  }
}
